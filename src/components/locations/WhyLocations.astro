---
import Img1 from "../../assets/photos/visuals/Visuel-08.jpg";
import Img2 from "../../assets/photos/visuals/Visuel-13.jpg";
import Img3 from "../../assets/photos/visuals/Visuel-14.jpg";

interface WhyItem {
    img: ImageMetadata;
    title: string;
    desc: string;
}

const items: WhyItem[] = [
    {
        img: Img1,
        title: "Se libérer de la contrainte informatique :",
        desc:
            "Une solution ajustée à la réalité du soin. Toutoléron, un partenaire e‑santé qui soulage du stress informatique.",
    },
    {
        img: Img2,
        title: "Sécuriser sa pratique médicale :",
        desc:
            "Des résultats concrets au quotidien avec moins de pannes, moins de charge mentale et plus de temps patient. Votre environnement informatique reste fiable et vos données protégées.",
    },
    {
        img: Img3,
        title: "Optimiser son cabinet pour mieux soigner :",
        desc:
            "Avec un écosystème numérique performant et toujours à jour, votre pratique médicale gagne en sérénité, fluidité et efficacité pour garantir le meilleur soin.",
    },
];
---

<section id="why-locations">
    <div data-anim-group class="px-6 md:px-16 grid lg:grid-cols-2 gap-8 items-start">
        <!-- Left column: heading + CTA -->
        <div class="flex flex-col justify-center mt-4">
            <h2 data-anim="reveal" class="text-3xl sm:text-4xl lg:text-5xl leading-tight">
                Pourquoi louer
                <span class="block"><span class="font-semibold">avec Toutoléron ?</span></span>
            </h2>

            <div data-anim="reveal" class="mt-8 mb-8 lg:mb-0">
                <!--<a onclick="plausible('cta_pourquoi_louer_avec_toutoleron')"-->
                <!--   target="_blank"-->
                <!--   href='https://outlook.office.com/book/CommercialToutolron@toutoleron.com/?ismsaljsauthenabled'-->
                <!--   class="btn btn-primary rounded-full p-6 text-xl text-accent shadow-none border-0"-->
                <!--&gt;-->
                <!--    Je prends rendez-vous-->
                <!--</a>-->
                <div class="dropdown dropdown-center">
                    <div tabindex="0" role="button"
                         class="mb-1 btn btn-primary p-6 text-xl text-primary-content rounded-full shadow-none border-0">
                        Je prends rendez-vous
                    </div>
                    <ul class="menu text-accent-content dropdown-content bg-accent rounded-box z-1 w-52 p-2 shadow-sm">
                        <li><a class="hover:link" onclick="plausible('booking_commerciale_navbar')"
                               target="_blank"
                               href="https://outlook.office.com/book/CommercialToutolron@toutoleron.com/?ismsaljsauthenabled">
                            Équipe commerciale
                        </a></li>
                        <li><a class="hover:link" onclick="plausible('booking_technique_navbar')"
                               target="_blank"
                               href="https://outlook.office.com/book/quipetechnique@toutoleron.com/?ismsaljsauthenabled">
                            Équipe technique
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right column: 3 media rows -->
        <div class="flex flex-col">
            <div data-anim="reveal" class="divider divider-primary"/>
            {items.map((it, index) => (
                    <div data-anim="reveal" class="grid grid-cols-1 sm:grid-cols-[220px_1fr] items-center gap-5">
                        <img src={it.img.src} alt="Illustration"
                             class="w-full h-48 sm:h-40 object-cover rounded-xl"/>
                        <div>
                            <p class="text-xl font-semibold">{it.title}</p>
                            <p class="mt-2 text-sm text-base-content/80">{it.desc}</p>
                        </div>
                    </div>
                    <div data-anim="reveal" class="divider divider-primary"/>
            ))}
        </div>
    </div>
</section>
