---
import Logo from "../assets/logos/TOUTOLERON_Logotype_blanc.svg";
import ArrowMenu from "../assets/svg/arrow-menu.svg";
import Programme3hUrl from "../assets/programmes/programme_3h.pdf?url";
import Programme5hUrl from "../assets/programmes/programme_5h.pdf?url";
import BookingCTA from "./BookingCTA.astro";
---

<div class="pt-2 px-2 md:px-16">
    <div class="navbar flex-col gap-4 sm:flex-row sm:gap-0 bg-accent text-accent-content rounded-2xl min-h-14">
        <div class="py-2 md:ps-6">
            <a href="/" class="flex items-center" aria-label="Accueil Toutoléron">
                <img src={Logo.src} alt="Toutoléron" class="w-48"/>
            </a>
        </div>

        <!--<a target="_blank" onclick="plausible('cta_navbar')"-->
        <!--   href='https://outlook.office.com/book/CommercialToutolron@toutoleron.com/?ismsaljsauthenabled'-->
        <!--   class="sm:hidden btn btn-primary text-md p-4 text-primary-content rounded-full shadow-none border-0">-->
        <!--    Prendre RDV-->
        <!--</a>-->

        <BookingCTA class="sm:hidden btn btn-primary text-md p-4 text-primary-content rounded-full shadow-none border-0"
                    label="Prendre RDV"/>

        <div class="flex grow justify-end">
            <div class="flex items-stretch">

                <div class="dropdown dropdown-center">
                    <div tabindex="0" role="button"
                         class="btn btn-link link-hover text-accent-content text-md">
                        Formations
                        <img class="h-3 w-3" src={ArrowMenu.src} alt="Voir les formations"/>
                    </div>
                    <ul class="menu text-accent-content dropdown-content bg-accent rounded-box z-1 w-52 p-2 shadow-sm">
                        <li>
                            <button type="button" class="hover:link"
                                    onclick="document.getElementById('programme-3h-modal').showModal()">
                                Programme 3h
                            </button>
                        </li>
                        <li>
                            <button type="button" class="hover:link"
                                    onclick="document.getElementById('programme-5h-modal').showModal()">
                                Programme 5h
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="dropdown dropdown-center">
                    <div tabindex="0" role="button"
                         class="btn btn-link link-hover text-accent-content text-md">
                        Solutions
                        <img class="h-3 w-3" src={ArrowMenu.src} alt="Voir les solutions"/>
                    </div>
                    <ul class="menu text-accent-content dropdown-content bg-accent rounded-box z-1 w-52 p-2 shadow-sm">
                        <li><a class="hover:link" href="/locations">Location & maintenance</a></li>
                    </ul>
                </div>

                <div class="dropdown dropdown-center">
                    <div tabindex="0" role="button"
                         class="btn btn-link link-hover text-accent-content text-md">
                        Ressources
                        <img class="h-3 w-3" src={ArrowMenu.src} alt="Voir les ressources"/>
                    </div>
                    <ul class="menu text-accent-content dropdown-content bg-accent rounded-box z-1 w-52 p-2 shadow-sm">
                        <li><a class="hover:link" onclick="plausible('kb_navbar')"
                               target="_blank" href="https://base-de-connaissances.toutoleron.com/">
                            Base de connaissances
                        </a></li>
                    </ul>
                </div>

                <BookingCTA class="hidden sm:flex btn btn-primary text-md p-4 text-primary-content rounded-full shadow-none border-0"
                            label="Prendre RDV"/>
            </div>
        </div>
    </div>

    <!-- Visionneuses PDF des programmes de formation -->
    <dialog id="programme-3h-modal" class="modal" data-pdf-src={Programme3hUrl}>
        <div class="modal-box w-11/12 max-w-5xl h-[85vh] p-0 flex flex-col overflow-hidden">
            <div class="flex items-center justify-between gap-4 p-3 border-b border-base-300">
                <h3 class="font-bold text-lg">Programme 3h</h3>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost" aria-label="Fermer">✕</button>
                </form>
            </div>
            <iframe title="Programme 3h" class="w-full grow border-0 bg-white"></iframe>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button aria-label="Fermer">close</button>
        </form>
    </dialog>

    <dialog id="programme-5h-modal" class="modal" data-pdf-src={Programme5hUrl}>
        <div class="modal-box w-11/12 max-w-5xl h-[85vh] p-0 flex flex-col overflow-hidden">
            <div class="flex items-center justify-between gap-4 p-3 border-b border-base-300">
                <h3 class="font-bold text-lg">Programme 5h</h3>
                <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost" aria-label="Fermer">✕</button>
                </form>
            </div>
            <iframe title="Programme 5h" class="w-full grow border-0 bg-white"></iframe>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button aria-label="Fermer">close</button>
        </form>
    </dialog>
</div>